# Com valor = front fala com API real; sem valor = mock in-browser
VITE_API_URL=http://192.168.15.119/barbear-ia/api/v1

Jwt__SigningKey=DEV_ONLY_CHANGE_ME_BarbearIA_Jwt_Signing_Key_32+
Seed__SuperAdmin__Email=admin@barbear.ia
Seed__SuperAdmin__Password=Admin123#
Swagger__Enabled=true


